generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
 
}

// ─────────────────────────────────────
// USERS
// ─────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         Role     @default(RIDER)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  fcmToken              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cars            Car[]
  tripsAsDriver   Trip[]        @relation("DriverTrips")
  bookings        Booking[]
  sentMessages    Message[]
  ratingsGiven    Rating[]      @relation("RatingsGiven")
  ratingsReceived Rating[]      @relation("RatingsReceived")
  returnAlerts    ReturnAlert[]
  routeAlerts     RouteAlert[]
  wallet          Wallet?
  disputesFiled   Dispute[]     @relation("DisputeReporter")
  sosAlerts       SosAlert[]
}

enum Role {
  RIDER
  DRIVER
  BOTH
  ADMIN
}

// ─────────────────────────────────────
// CARS
// ─────────────────────────────────────
model Car {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  make        String
  model       String
  year        Int
  plateNumber String   @unique
  totalSeats  Int
  isAC        Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  trips Trip[]

  @@index([ownerId])
}

// ─────────────────────────────────────
// TRIPS
// ─────────────────────────────────────
model Trip {
  id               String     @id @default(uuid())
  driverId         String
  driver           User       @relation("DriverTrips", fields: [driverId], references: [id])
  carId            String
  car              Car        @relation(fields: [carId], references: [id])

  originCity       String
  destinationCity  String
  originLat        Float
  originLng        Float
  destinationLat   Float
  destinationLng   Float

  departureTime    DateTime
  estimatedArrival DateTime

  routeCities      String[]

  totalSeats       Int
  pricePerKm       Float
  distanceKm       Float
  encodedPolyline  String

  allowSharing     Boolean    @default(true)
  status           TripStatus @default(SCHEDULED)
  cancellationNote String?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  waypoints        Waypoint[]
  bookings         Booking[]
  gpsPings         GpsPing[]
  messages         Message[]
  returnSlot       ReturnSlot?
  shareLink        TripShareLink?
  sosAlerts        SosAlert[]

  @@index([status])
  @@index([originCity, destinationCity])
  @@index([departureTime])
  @@index([driverId])
}

enum TripStatus {
  SCHEDULED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────
// WAYPOINTS
// ─────────────────────────────────────
model Waypoint {
  id               String    @id @default(uuid())
  tripId           String
  trip             Trip      @relation(fields: [tripId], references: [id])

  cityName         String
  lat              Float
  lng              Float
  sequenceIndex    Int
  estimatedArrival DateTime
  actualArrival    DateTime?

  @@unique([tripId, sequenceIndex])
  @@index([tripId, sequenceIndex])
}

// ─────────────────────────────────────
// SEAT SEGMENTS
// ─────────────────────────────────────
model SeatSegment {
  id            String  @id @default(uuid())
  tripId        String
  bookingId     String  @unique
  booking       Booking @relation(fields: [bookingId], references: [id])
  fromIndex     Int
  toIndex       Int
  seatsOccupied Int

  @@index([tripId, fromIndex, toIndex])
}

// ─────────────────────────────────────
// BOOKINGS
// ─────────────────────────────────────
model Booking {
  id             String        @id @default(uuid())
  tripId         String
  trip           Trip          @relation(fields: [tripId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])

  boardingCity   String
  alightingCity  String
  boardingIndex  Int
  alightingIndex Int
  seatsBooked    Int

  totalAmount    Float
  status         BookingStatus @default(CONFIRMED)
  isReturnTrip   Boolean       @default(false)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payment        Payment?
  seatSegment    SeatSegment?
  rating         Rating?
  disputes       Dispute[]

  @@index([userId])
  @@index([tripId])
  @@index([status])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ─────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────
model Payment {
  id                  String        @id @default(uuid())
  bookingId           String        @unique
  booking             Booking       @relation(fields: [bookingId], references: [id])

  razorpayOrderId     String        @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?

  amount              Float
  currency            String        @default("INR")
  status              PaymentStatus @default(INITIATED)

  refundId            String?
  refundAmount        Float?
  refundedAt          DateTime?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

enum PaymentStatus {
  INITIATED
  CAPTURED
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

// ─────────────────────────────────────
// RETURN SLOTS
// ─────────────────────────────────────
model ReturnSlot {
  id                  String           @id @default(uuid())
  tripId              String           @unique
  trip                Trip             @relation(fields: [tripId], references: [id])

  returnOrigin        String
  returnDestination   String
  estimatedReturnDate DateTime
  status              ReturnSlotStatus @default(OPEN)
  returnTripId        String?          @unique

  createdAt           DateTime         @default(now())

  returnAlerts        ReturnAlert[]

  @@index([returnOrigin, returnDestination])
  @@index([status])
}

enum ReturnSlotStatus {
  OPEN
  CONFIRMED
  CANCELLED
}

// ─────────────────────────────────────
// RETURN ALERTS
// ─────────────────────────────────────
model ReturnAlert {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  returnSlotId String
  returnSlot   ReturnSlot @relation(fields: [returnSlotId], references: [id])
  notified     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([userId, returnSlotId])
  @@index([returnSlotId, notified])
}

// ─────────────────────────────────────
// ROUTE ALERTS
// ─────────────────────────────────────
model RouteAlert {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fromCity  String
  toCity    String
  date      DateTime
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fromCity, toCity, date, notified])
}

// ─────────────────────────────────────
// GPS PINGS
// ─────────────────────────────────────
model GpsPing {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  lat       Float
  lng       Float
  speed     Float?
  heading   Float?
  timestamp DateTime @default(now())

  @@index([tripId, timestamp])
}

// ─────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────
model Message {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
}

// ─────────────────────────────────────
// RATINGS
// ─────────────────────────────────────
model Rating {
  id        String     @id @default(uuid())
  bookingId String     @unique
  booking   Booking    @relation(fields: [bookingId], references: [id])
  raterId   String
  rater     User       @relation("RatingsGiven", fields: [raterId], references: [id])
  rateeId   String
  ratee     User       @relation("RatingsReceived", fields: [rateeId], references: [id])
  score     Int
  comment   String?
  type      RatingType
  createdAt DateTime   @default(now())

  @@index([rateeId])
}

enum RatingType {
  RIDER_TO_DRIVER
  DRIVER_TO_RIDER
}

// ─────────────────────────────────────
// WALLET & PAYOUTS
// ─────────────────────────────────────
model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  balance        Float    @default(0)
  pendingBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions WalletTransaction[]
  payouts      Payout[]
}

model WalletTransaction {
  id          String                @id @default(uuid())
  walletId    String
  wallet      Wallet                @relation(fields: [walletId], references: [id])
  type        WalletTransactionType
  amount      Float
  description String?
  bookingId   String?
  tripId      String?
  releasedAt  DateTime?
  createdAt   DateTime              @default(now())

  @@index([walletId, createdAt])
  @@index([tripId, releasedAt])
}

enum WalletTransactionType {
  EARNING_PENDING
  EARNING
  PAYOUT
  REVERSAL
  ADJUSTMENT
}

model Payout {
  id          String       @id @default(uuid())
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [id])
  amount      Float
  status      PayoutStatus @default(PENDING)
  bankRef     String?
  adminNote   String?
  requestedAt DateTime     @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([walletId])
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// ─────────────────────────────────────
// DISPUTES
// ─────────────────────────────────────
model Dispute {
  id           String        @id @default(uuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id])
  reporterId   String
  reporter     User          @relation("DisputeReporter", fields: [reporterId], references: [id])
  reason       String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  refundAmount Float?
  adminNote    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([bookingId])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

// ─────────────────────────────────────
// SAFETY — SHARE LINK & SOS
// ─────────────────────────────────────
model TripShareLink {
  id        String    @id @default(uuid())
  tripId    String    @unique
  trip      Trip      @relation(fields: [tripId], references: [id])
  token     String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model SosAlert {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lat       Float?
  lng       Float?
  message   String?
  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
}